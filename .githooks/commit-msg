#!/bin/sh
# Riot Commander commit-msg hook.
#
# Install per-clone with:
#   python scripts/install_hooks.py        (sets core.hooksPath for you)
# or directly:
#   git config core.hooksPath .githooks
#
# Two jobs, and BOTH must stay here. Until 2026-07-26 they lived in two different
# files - the trailer strip only in the untracked `.git/hooks/commit-msg`, the
# subject validation only in this tracked one - so whichever file `core.hooksPath`
# resolved to, one of the two silently did not run.

set -e

ROOT="$(git rev-parse --show-toplevel)"
PY="${PYTHON:-py}"

if ! command -v "$PY" >/dev/null 2>&1; then
    PY=python
fi

# 1. Operator policy 2026-06-03: never emit the Claude co-author trailer.
# Strip it rather than reject it, so a session that adds one out of habit still
# commits cleanly. Runs FIRST so the subject validation below sees the final
# message. `|| true` because grep exits 1 when it filters every line.
tmp="$1.rcfilt"
grep -v -i '^Co-Authored-By: Claude' "$1" > "$tmp" || true
mv "$tmp" "$1"

# 2. Banned glyphs in the MESSAGE.
#
# This half CANNOT live in pre-commit. Git's order is pre-commit -> prepare the
# message -> commit-msg, so `.git/COMMIT_EDITMSG` does not exist yet when
# pre-commit runs and there is nothing to scan. Splitting the gate across the
# two hooks is therefore required, not stylistic.
#
# MEASURED 2026-07-26: while the gate was invoked only from pre-commit (as
# `echo "git commit" | gate`), the staged-content and ruff halves still fired -
# so it LOOKED healthy - while a U+2014 em-dash in a commit SUBJECT committed
# clean. Credit to the parallel Sibling-A session for predicting this
# exact failure before RC probed it.
"$PY" "$ROOT/tools/precommit_gate.py" --message-file "$1" || exit 1

# 3. Validate the subject line against Conventional Commits.
"$PY" "$ROOT/scripts/precommit_msg_check.py" "$1" || exit 1
