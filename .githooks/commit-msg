#!/bin/sh
# Amberstone commit-msg hook.
#
# Install per-clone with:
#   python scripts/install_hooks.py        (sets core.hooksPath for you)
# or directly:
#   git config core.hooksPath .githooks
#
# Two jobs, and BOTH must stay here. Until 2026-07-26 they lived in two different
# files - the trailer strip only in the untracked `.git/hooks/commit-msg`, the
# subject validation only in this tracked one - so whichever file `core.hooksPath`
# resolved to, one of the two silently did not run.

set -e

ROOT="$(git rev-parse --show-toplevel)"
PY="${PYTHON:-py}"

if ! command -v "$PY" >/dev/null 2>&1; then
    PY=python
fi

# 1. Operator policy 2026-06-03: never emit the Claude co-author trailer.
# Strip it rather than reject it, so a session that adds one out of habit still
# commits cleanly. Runs FIRST so the subject validation below sees the final
# message. `|| true` because grep exits 1 when it filters every line.
tmp="$1.rcfilt"
grep -v -i '^Co-Authored-By: Claude' "$1" > "$tmp" || true
mv "$tmp" "$1"

# 1b. FLEET-KIT v13 (FLEET-COMMON 17, NO AI OR BOT ATTRIBUTION; MAIN 2026-10-08
# 2246 ORDER section 1 step 4): the kit strips every AI / bot co-author or
# sign-off trailer, any `Claude-*:` trailer, a "Generated with Claude Code" line
# and a bare claude.ai session URL line, and logs the count to the gitignored
# ops/loop/control/identity.jsonl. It never rejects, so `|| true`. The line is
# the kit's wiring string verbatim (the hook runs at the top of the work tree).
python "ops/fleet_kit/fleet_identity.py" commit-msg "$1" || true

# 2. Banned glyphs in the MESSAGE.
#
# This half CANNOT live in pre-commit. Git's order is pre-commit -> prepare the
# message -> commit-msg, so `.git/COMMIT_EDITMSG` does not exist yet when
# pre-commit runs and there is nothing to scan. Splitting the gate across the
# two hooks is therefore required, not stylistic.
#
# MEASURED 2026-07-26: while the gate was invoked only from pre-commit (as
# `echo "git commit" | gate`), the staged-content and ruff halves still fired -
# so it LOOKED healthy - while a U+2014 em-dash in a commit SUBJECT committed
# clean. Credit to the parallel Sibling-A session for predicting this
# exact failure before RC probed it.
"$PY" "$ROOT/tools/precommit_gate.py" --message-file "$1" || exit 1

# 3. Validate the subject line against Conventional Commits.
"$PY" "$ROOT/scripts/precommit_msg_check.py" "$1" || exit 1

# 4. RM-1271 (MAIN ORDER 2026-10-31-2215 item 5; adjudicated s161 after 1459 of
# 1462 lane commits 2026-11-04..11-11 carried it; the 3 misses are s158
# main-session fixups on lane/repo): a commit on a lane branch
# `lane/<x>` must END with the trailer line `Lane: <x>`. Only lane branches are
# checked - a detached HEAD (every rebase step) and any other branch, main
# included, pass untouched. "End" = the last non-blank line once `#` comment
# lines are dropped and anything below a scissors line is cut, as git's default
# cleanup does; trailing whitespace is ignored. Runs after both strips (1, 1b),
# so a stripped AI trailer below `Lane:` cannot fail a correct commit. Inline
# POSIX sh on purpose, never a new script under the tree root: a lane worktree
# runs main's hook against its own older tree, where a newer script would be
# missing and would refuse every lane commit. printf, not echo: dash's echo
# expands backslashes in the quoted line.
lane_branch="$(git symbolic-ref --short -q HEAD || true)"
case "$lane_branch" in
    lane/?*)
        lane="${lane_branch#lane/}"
        lane_last="$(sed -e '/^# -\{24\} >8 -\{24\}$/,$d' -e '/^#/d' \
            -e 's/[[:space:]]*$//' -e '/^$/d' "$1" | tail -n 1)"
        if [ "$lane_last" != "Lane: $lane" ]; then
            printf '%s\n' "commit-msg: RM-1271 a commit on lane/$lane must end with the trailer line 'Lane: $lane' (last line: '$lane_last')" >&2
            exit 1
        fi
        ;;
esac
