 },
 "chart_README": "Kit v16: chart = the validated fleet tree palette (MAIN tools/fleet_insights_lib/palette.py TREE_COLORS, light + dark), slot i = chart_order[i], the launch / stack order. Contrast below 3:1 on surface is a validator WARN, relieved by direct labels and a table view; never colour alone.",
 "chart_order": ["RC", "LW", "LL", "CS", "RSC", "SS", "EW", "HOM"],
 "chart": {
  "light": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "dark": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"]
 },
 "states": {
  "_README": "Kit v9 state vocabulary (UI/UX standard section 1; v14 adds blocked = an outside condition such as a proxy outage stops the run, distinct from refused): the single source for every status surface. glyph = one-char slot, row = bracket form in rows, word = the text carrier, token = the status colour key above. Colour never carries a state alone.",
  "running": {"glyph": ">", "row": "[>]", "word": "running", "token": "running"},
  "done": {"glyph": "+", "row": "[+]", "word": "done", "token": "ok"},
  "failed": {"glyph": "x", "row": "[x]", "word": "failed", "token": "bad"},
  "stale": {"glyph": "!", "row": "[!]", "word": "STALE", "token": "bad"},
  "halted": {"glyph": "=", "row": "[=]", "word": "halted", "token": "halted"},
  "pending": {"glyph": ".", "row": "[ ]", "word": "pending", "token": "idle"},
  "needs-operator": {"glyph": "?", "row": "[?]", "word": "needs you", "token": "warn"},
  "blocked": {"glyph": "#", "row": "[#]", "word": "blocked", "token": "warn"},
  "idle": {"glyph": "-", "row": "[-]", "word": "idle", "token": "idle"}
 },
 "status_map": {
