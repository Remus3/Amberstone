    {"id": "ar-target-b", "fn": "effective_resist", "args": [18, 0], "kwargs": {"flat_reduction": 30, "pct_reductions": [0.30], "bonus_pct_pens": [0.45], "flat_pen": 10}, "expected": -12, "source": "wiki_arpen", "boundary": "after reduction crosses zero every later step is skipped"},
