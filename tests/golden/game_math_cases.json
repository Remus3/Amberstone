    {"id": "mr-flatred-below-zero", "fn": "effective_resist", "args": [10, 0], "kwargs": {"flat_reduction": 25}, "expected": -15, "source": "wiki_mpen", "boundary": "reduction crosses zero"},
    {"id": "mr-pctred-20", "fn": "effective_resist", "args": [30, 0], "kwargs": {"pct_reductions": [0.20]}, "expected": 24, "source": "wiki_mpen"},
    {"id": "mr-pctpen-20", "fn": "effective_resist", "args": [30, 0], "kwargs": {"pct_pens": [0.20]}, "expected": 24, "source": "wiki_mpen"},
    {"id": "mr-flatpen-20", "fn": "effective_resist", "args": [30, 0], "kwargs": {"flat_pen": 20}, "expected": 10, "source": "wiki_mpen"},
    {"id": "mr-target-a", "fn": "effective_resist", "args": [80, 0], "kwargs": {"flat_reduction": 20, "pct_reductions": [0.30], "pct_pens": [0.35], "flat_pen": 10}, "expected": 17.3, "source": "wiki_mpen"},
    {"id": "mr-target-b", "fn": "effective_resist", "args": [18, 0], "kwargs": {"flat_reduction": 20, "pct_reductions": [0.30], "pct_pens": [0.35], "flat_pen": 10}, "expected": -2, "source": "wiki_mpen", "boundary": "after reduction crosses zero every later step is skipped"},

    {"id": "pct-combine-20-30-armor", "fn": "combine_percent", "args": [[0.20, 0.30]], "expected": 0.44, "source": "wiki_arpen"},
    {"id": "pct-combine-20-30-mr", "fn": "combine_percent", "args": [[0.20, 0.30]], "expected": 0.44, "source": "wiki_mpen"},
    {"id": "pct-combine-voidstaff-shoes", "fn": "combine_percent", "args": [[0.40, 0.08]], "expected": 0.448, "source": "wiki_mpen"},
    {"id": "pct-combine-voidstaff-shoes-tibbers", "fn": "combine_percent", "args": [[0.40, 0.08, 0.20]], "expected": 0.5584, "source": "wiki_mpen"},
    {"id": "pct-combine-ldr-apprehend", "fn": "combine_percent", "args": [[0.40, 0.35]], "expected": 0.61, "source": "wiki_arpen"},

    {"id": "resmult-taric", "fn": "resist_with_multipliers", "args": [124.56, 576, [0.30], [0.20, 0.03]], "expected": 1079.47, "tol": 0.005, "source": "wiki_armor"},
    {"id": "resmult-braum-armor", "fn": "resist_with_multipliers", "args": [120, 568, [0.30], [0.20, 0.03]], "expected": 1060.98, "tol": 0.005, "source": "wiki_armor"},
    {"id": "resmult-braum-mr", "fn": "resist_with_multipliers", "args": [72.31, 593.78, [0.30], [0.20, 0.03]], "expected": 1043.46, "tol": 0.005, "source": "wiki_mr"},

