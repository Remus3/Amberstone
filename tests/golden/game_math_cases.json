{
  "_doc": "P1-5 golden parity fixtures for game math. EVERY expected value comes from an EXTERNAL document named in the case's source (a League wiki worked example at a pinned revision, or a language reference's documented example). No expected value here was produced by running RC code: a golden built from our own implementation proves nothing. Only numbers (facts) are recorded, never page text. Fetched 2026-10-04. Add a case only with an external source; tests/test_math_core_golden.py refuses a case without one.",
  "sources": {
    "wiki_armor": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Armor?oldid=4073057", "where": "Damage formula examples; Stacking armor; Highest armor examples"},
    "wiki_mr": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Magic_resistance?oldid=4073058", "where": "Stacking magic resistance; Highest magic resistance examples"},
    "wiki_arpen": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Armor_penetration?oldid=4035725", "where": "Armor reduction / penetration examples; Examples (Target A / Target B); Highest armor penetration"},
    "wiki_mpen": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Magic_penetration?oldid=4060414", "where": "Magic resistance reduction / penetration examples; Examples (Target A / Target B); Highest magic penetration"},
    "wiki_stat": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Champion_statistic?oldid=4069636", "where": "Growth by level; Generic growth example; Attack speed growth example"},
    "wiki_as": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Attack_speed?oldid=4073067", "where": "Simple example; Full example (V25.10)"},
    "wiki_crit": {"kind": "wiki", "url": "https://wiki.leagueoflegends.com/en-us/Critical_strike?oldid=4059009", "where": "Average damage multiplier example"},
    "py_round": {"kind": "language-doc", "url": "https://docs.python.org/3/library/functions.html#round", "where": "round() description and its float note"},
    "js_math_round": {"kind": "language-doc", "url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Math/round", "where": "Examples: Using round"},
    "js_to_fixed": {"kind": "language-doc", "url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Number/toFixed", "where": "Examples: Using toFixed"},
    "ecma_to_fixed": {"kind": "language-doc", "url": "https://tc39.es/ecma262/#sec-number.prototype.tofixed", "where": "Number.prototype.toFixed steps: a negative x is negated with a '-' prefix; of two equally close n, pick the larger n"}
  },
  "rejected": [
    {"id": "resmult-malphite", "source": "wiki_armor", "why": "the page's own arithmetic does not reproduce its stated result: its inputs give 2989.938 under its own formula, the page states 2989.923558. An externally inconsistent example cannot be a golden."},
    {"id": "resmult-rammus", "source": "wiki_mr", "why": "the page's own arithmetic does not reproduce its stated result: its inputs give 2275.95 under its own formula, the page states 2271.99. An externally inconsistent example cannot be a golden."}
  ],
  "cases": [
    {"id": "mit-armor-25", "fn": "post_mitigation_damage", "args": [1000, 25], "expected": 800, "source": "wiki_armor"},
    {"id": "mit-armor-100", "fn": "post_mitigation_damage", "args": [1000, 100], "expected": 500, "source": "wiki_armor"},
    {"id": "mit-armor-200", "fn": "post_mitigation_damage", "args": [1000, 200], "expected": 333.3, "tol": 0.05, "source": "wiki_armor", "note": "page shows one decimal"},
    {"id": "dr-armor-25", "fn": "damage_reduction_fraction", "args": [25], "expected": 0.20, "source": "wiki_armor"},
    {"id": "dr-armor-100", "fn": "damage_reduction_fraction", "args": [100], "expected": 0.50, "source": "wiki_armor"},
    {"id": "dr-armor-200", "fn": "damage_reduction_fraction", "args": [200], "expected": 0.666, "tol": 0.001, "source": "wiki_armor", "note": "page shows 66.6 percent"},
    {"id": "ehp-armor-25", "fn": "effective_health", "args": [1000, 25], "expected": 1250, "source": "wiki_armor"},
