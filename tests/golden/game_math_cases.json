    {"id": "hud-as-panel-volibear", "fn": "to_fixed", "args": [0.82065, 2], "expected": "0.82", "js": "(0.82065).toFixed(2)", "source": "wiki_stat"},
    {"id": "hud-as-tooltip-volibear", "fn": "to_fixed", "args": [0.82065, 3], "expected": "0.821", "js": "(0.82065).toFixed(3)", "source": "wiki_stat"},
    {"id": "hud-as-panel-tf", "fn": "to_fixed", "args": [1.3563985257149, 2], "expected": "1.36", "js": "(1.3563985257149).toFixed(2)", "source": "wiki_as"},
    {"id": "hud-as-tooltip-tf", "fn": "to_fixed", "args": [1.3563985257149, 3], "expected": "1.356", "js": "(1.3563985257149).toFixed(3)", "source": "wiki_as"},

    {"id": "py-round-0.5", "fn": "round_half_even", "args": [0.5, 0], "expected": 0, "source": "py_round", "boundary": "exact tie goes to even"},
    {"id": "py-round-neg0.5", "fn": "round_half_even", "args": [-0.5, 0], "expected": 0, "source": "py_round", "boundary": "exact tie goes to even"},
    {"id": "py-round-1.5", "fn": "round_half_even", "args": [1.5, 0], "expected": 2, "source": "py_round", "boundary": "exact tie goes to even"},
    {"id": "py-round-2.675", "fn": "round_half_even", "args": [2.675, 2], "expected": 2.67, "source": "py_round", "boundary": "decimal tie is below the tie in binary"},
    {"id": "js-round-neg20.51", "fn": "js_math_round", "args": [-20.51], "expected": -21, "js": "Math.round(-20.51)", "source": "js_math_round"},
    {"id": "js-round-neg20.5", "fn": "js_math_round", "args": [-20.5], "expected": -20, "js": "Math.round(-20.5)", "source": "js_math_round", "boundary": "tie goes toward +infinity, not away from zero"},
    {"id": "js-round-neg0.1", "fn": "js_math_round", "args": [-0.1], "expected": -0.0, "js": "Math.round(-0.1)", "source": "js_math_round", "boundary": "negative zero"},
    {"id": "js-round-0", "fn": "js_math_round", "args": [0], "expected": 0, "js": "Math.round(0)", "source": "js_math_round"},
    {"id": "js-round-20.49", "fn": "js_math_round", "args": [20.49], "expected": 20, "js": "Math.round(20.49)", "source": "js_math_round"},
    {"id": "js-round-20.5", "fn": "js_math_round", "args": [20.5], "expected": 21, "js": "Math.round(20.5)", "source": "js_math_round", "boundary": "tie goes toward +infinity"},
    {"id": "js-round-42", "fn": "js_math_round", "args": [42], "expected": 42, "js": "Math.round(42)", "source": "js_math_round"},
    {"id": "js-fixed-12345.6789-0", "fn": "to_fixed", "args": [12345.6789, 0], "expected": "12346", "js": "(12345.6789).toFixed(0)", "source": "js_to_fixed"},
    {"id": "js-fixed-12345.6789-1", "fn": "to_fixed", "args": [12345.6789, 1], "expected": "12345.7", "js": "(12345.6789).toFixed(1)", "source": "js_to_fixed"},
    {"id": "js-fixed-12345.6789-6", "fn": "to_fixed", "args": [12345.6789, 6], "expected": "12345.678900", "js": "(12345.6789).toFixed(6)", "source": "js_to_fixed"},
    {"id": "js-fixed-1.23e-10", "fn": "to_fixed", "args": [1.23e-10, 2], "expected": "0.00", "js": "(1.23e-10).toFixed(2)", "source": "js_to_fixed"},
    {"id": "js-fixed-2.34", "fn": "to_fixed", "args": [2.34, 1], "expected": "2.3", "js": "(2.34).toFixed(1)", "source": "js_to_fixed"},
    {"id": "js-fixed-2.35", "fn": "to_fixed", "args": [2.35, 1], "expected": "2.4", "js": "(2.35).toFixed(1)", "source": "js_to_fixed", "boundary": "decimal tie is above the tie in binary"},
    {"id": "js-fixed-2.55", "fn": "to_fixed", "args": [2.55, 1], "expected": "2.5", "js": "(2.55).toFixed(1)", "source": "js_to_fixed", "boundary": "decimal tie is below the tie in binary"},
    {"id": "js-fixed-2.4499", "fn": "to_fixed", "args": [2.449999999999999999, 1], "expected": "2.5", "js": "(2.449999999999999999).toFixed(1)", "source": "js_to_fixed", "boundary": "literal encodes the same double as 2.45"},
    {"id": "js-fixed-neg2.34", "fn": "to_fixed", "args": [-2.34, 1], "expected": "-2.3", "js": "(-2.34).toFixed(1)", "source": "js_to_fixed"},
    {"id": "spec-fixed-0.5", "fn": "to_fixed", "args": [0.5, 0], "expected": "1", "js": "(0.5).toFixed(0)", "source": "ecma_to_fixed", "boundary": "exact binary tie picks the larger n (Python round gives 0)"},
    {"id": "spec-fixed-2.5", "fn": "to_fixed", "args": [2.5, 0], "expected": "3", "js": "(2.5).toFixed(0)", "source": "ecma_to_fixed", "boundary": "exact binary tie picks the larger n (Python round gives 2)"},
    {"id": "spec-fixed-1.25", "fn": "to_fixed", "args": [1.25, 1], "expected": "1.3", "js": "(1.25).toFixed(1)", "source": "ecma_to_fixed", "boundary": "exact binary tie picks the larger n (Python round gives 1.2)"},
    {"id": "spec-fixed-neg2.5", "fn": "to_fixed", "args": [-2.5, 0], "expected": "-3", "js": "(-2.5).toFixed(0)", "source": "ecma_to_fixed", "boundary": "sign is taken off first, so a negative tie rounds away from zero"}
  ]
}
