    {"id": "ehp-armor-200", "fn": "effective_health", "args": [1000, 200], "expected": 3000, "source": "wiki_armor"},
    {"id": "ehp-armor-60", "fn": "effective_health", "args": [1000, 60], "expected": 1600, "source": "wiki_armor"},
