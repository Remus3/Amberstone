# Secrets — NEVER commit
API-Key-Claude.txt
*.key
*.pem
.env
.env.*
!.env.example

# Embedded Python distribution (64 MB, vendored)
python-embed/

# Audit-cleanup quarantine (move-not-delete pattern; safe to rm after stability confirmed)
_archive/

# Match-history + decisions databases (1.8 GB, mostly rewind_history.db)
# Recursive — earlier `data/*.db` only caught direct children, not data/db/*.db
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# Coach settings — runtime-mutated by /api/coach/toggle (dashboard ops tab).
# Track config/coach_settings.example.json as the template instead.
config/coach_settings.json

# Live coaching state (mutates per game — written by main.py atomically)
coaching_data.json
data/aram_coaching_data.json
data/arena_coaching_data.json
data/brawl_coaching_data.json
data/tft_coaching_data.json
data/cold_advisories.json
data/insight_cooldowns.json
data/ratings/last_*.json
data/coach_trace.jsonl
data/spend/
data/vision_state.json
data/decisions_pending.json
data/decisions_log.jsonl

# Local-only Claude / MCP config (may contain server URLs, tokens)
.claude/
.mcp.json

# Scraped meta build pages (re-fetchable, large)
data/meta_build/scraped/
data/rewind_cache/

# TLS / debug screenshots + frame captures committed during dev
ops/tls/*.png
ops/tls/*.jpg
ops/tls/*.jpeg

# CommunityDragon / DDragon meta dumps (re-fetchable, very large)
data/meta/cdragon_*.json

# Logs (146 MB, daily rotating)
logs/

# Runtime state (mutates constantly)
ops/runtime/
restart_trigger.txt
agents/state/
!agents/state/resolved_decisions.json

# Dev UI diff screenshots (43 MB — re-generated by audit runs; opt-in later if useful)
docs/ui_audit/

# Sync staging
moon_sync_inbox/
tmp/

# Vision / OCR cache + transient debug captures
data/debug_*.json
data/sim/cache/
data/screenshots/
data/ocr_cache/
moon_vision_server.log
moon_vision_server.log.*

# Local DDragon mirror — re-fetchable, large; keep meta/ddragon_*.json (small) but skip the per-version mirror
web/data/ddragon/

# Audit/snapshot tarballs
audit-pre-opus.tar.gz
*.tar.gz
*.zip
!data/sim/*.zip

