__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.tox/
.coverage
htmlcov/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local-only memory / scratch (per CLAUDE.md these live in user dir, not project)
.claude/local/

# Profiling output
*.prof
*.lprof

# Node (if any future tooling)
node_modules/
package-lock.json

# Ad-hoc diagnostic artefacts under data/. Leading dot keeps them sorted
# to the top of the dir + signals "transient debug output, not persistent
# state". e.g. .gamepc-shot.png, .capture-from-gamepc.png from screenshot
# pulls during audits.
data/.*.png
data/.*.json
data/.*.jsonl
data/.*.tmp

# Transient health reports — regenerated by scripts/db_size_monitor.py
# every run. champ_kda.json IS committed (recommender consumes it for
# fast cold-cache); db_sizes is just a numerical snapshot.
data/coach_reference/db_sizes.json

# Cross-Claude bridge folder (RC ↔ Peer-VIP). Durable inheritance docs
# (PEER_VIP_ARCHITECTURE / SETUP / INTAKE_QA / UPDATE_FROM_RC_* /
# WT_INHERITANCE_*) ARE tracked. Round-trip scratch — asks, file bundles,
# post-update return prompts, parity sync snapshots — gets consumed by
# the other Claude once and becomes stale; keep it local.
docs io RC peer/*ASKS*
docs io RC peer/*BUNDLE*
docs io RC peer/*POST_UPDATE*
docs io RC peer/*PARITY*
docs io RC peer/*SECRET*
docs io RC peer/*HANDSHAKE*
docs io RC peer/*PIVOT*
docs io RC peer/*REPLY*
# Catch-all for any cross-Claude scratch that mentions secrets/tokens/keys
# in its filename. Add new round-trip-artifact patterns here as they emerge,
# OR consider flipping to a "ignore everything, allow-list durables" model
# once the pattern list grows past ~10.
docs io RC peer/*TOKEN*
docs io RC peer/*KEY*

# Per-host bridge secrets. Tracked: ops/local_paths.example.json (template).
# Gitignored: ops/local_paths.json (real, contains the shared bearer token).
ops/local_paths.json

# Operator-curated SR draft builds (Phase 8). Not source — each
# operator's builds are theirs alone.
data/daemon_slayer/user_builds.json
